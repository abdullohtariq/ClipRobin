{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Clip Robin",
  "version": "0.1.32",
  "identifier": "com.cliprobin.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build -- --webpack"
  },
  "app": {
    "windows": [
      {
        "title": "Clip Robin",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost tauri: http://tauri.localhost https://tauri.localhost http://127.0.0.1:* http://localhost:* https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:* https://*.ytimg.com https://yt3.ggpht.com; media-src 'self' blob: http://127.0.0.1:* http://localhost:*; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "resources": {
      "../../backend/dist/cliprobin-api.exe": "cliprobin-api.exe",
      "../../backend/bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "../../backend/bin/ffprobe.exe": "bin/ffprobe.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4OUU4RkM1NUQ0MEQyN0YKUldSLzBrQmR4WStlK0dMVEJ2L0FZbms3TTl6cSszWjlCNDhIMGtQRUpkRCsvTFp2UGRhbS90cWYK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/abdullohtariq/ClipRobin/releases/latest/download/latest.json"
      ]
    }
  }
}
