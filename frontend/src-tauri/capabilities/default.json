{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://polar.sh/**" },
        { "url": "https://sandbox.polar.sh/**" },
        { "url": "https://*/subscription/" },
        { "url": "https://*/subscription" }
      ]
    },
    "process:allow-restart",
    "updater:default"
  ]
}
