# Use the Project URL and publishable key from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional HTTPS URL of the deployed Account & Plans page, including /subscription.
NEXT_PUBLIC_CLIPROBIN_ACCOUNT_URL=
# Optional subpath when hosting the Account & Plans export under a subdirectory (e.g. /cliprobin-web).
NEXT_PUBLIC_CLIPROBIN_ACCOUNT_BASE_PATH=

# Enable a browser sign-in button after configuring that provider in Supabase.
NEXT_PUBLIC_CLIPROBIN_GITHUB_AUTH=0
NEXT_PUBLIC_CLIPROBIN_GOOGLE_AUTH=0
