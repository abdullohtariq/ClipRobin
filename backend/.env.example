# Choose: gemini, openai, or deepseek
AI_PROVIDER=gemini

# Add only the key for the provider you use (Gemini can also be configured in Settings -> AI Developer Mode).
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional model overrides (Gemini defaults to gemini-3.8-flash -> gemini-3.1-flash-lite fallback)
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-chat

# Optional endpoint overrides for compatible/self-hosted gateways
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Optional local Whisper overrides
# WHISPER_MODEL=base
# WHISPER_COMPUTE_TYPE=int8

# Optional YouTube Data API v3 OAuth credentials (can also be set in Settings)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# Optional Paddle Billing v2 webhook configuration
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_WEBHOOK_SECRET=
# PADDLE_CLIENT_TOKEN=
